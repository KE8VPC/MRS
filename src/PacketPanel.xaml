<UserControl x:Class="MRS.PacketPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#101722" Foreground="#E4EDF8">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="65"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="80"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="DATA · RECEIVE ONLY" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <WrapPanel><CheckBox x:Name="EnableDecoder" Content="AX.25 / APRS" ToolTip="Enable 1200-baud AX.25/APRS decoding from NFM or compatible radio audio." Foreground="#E4EDF8" Checked="EnableChanged" Unchecked="EnableChanged" VerticalAlignment="Center" Margin="0,0,15,0"/><CheckBox x:Name="EnableP25" Content="P25 Phase I" ToolTip="Enable P25 Phase I C4FM data decoding from NFM SDR or I/Q replay." Foreground="#E4EDF8" Checked="P25EnableChanged" Unchecked="P25EnableChanged" VerticalAlignment="Center" Margin="0,0,15,0"/><CheckBox x:Name="EnableSubaudible" Content="CTCSS / DCS" Foreground="#E4EDF8" Checked="SubaudibleEnableChanged" Unchecked="SubaudibleEnableChanged" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="Detect PL / DPL tones and codes from NFM SDR or audio that preserves subaudible frequencies. Does not change listening squelch."/><Button Content="Clear" Click="Clear"/><Button Content="Export JSON" Click="Export"/></WrapPanel>
   <Expander Header="Decoder status and help" Foreground="#9EB1C9" Margin="0,5,0,0" IsExpanded="False"><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,0">
   <TextBlock x:Name="InputStatus" Text="Decoder off" TextWrapping="Wrap" Foreground="#66DEBA" Margin="0,8,0,4"/>
   <TextBlock x:Name="P25Status" Text="P25 off" TextWrapping="Wrap" Foreground="#66DEBA" Margin="0,0,0,4"/>
   <TextBlock x:Name="SubaudibleStatus" Text="CTCSS / DCS off" TextWrapping="Wrap" Foreground="#66DEBA" Margin="0,0,0,4"/>
   <TextBlock Text="Group repeated P25 messages to keep status readable. Turn grouping off for individual messages. Each view keeps up to 500 rows. Select a row for full details; export follows the current view and filter." TextWrapping="Wrap" Foreground="#9EB1C9" FontSize="12"/>
   </StackPanel></ScrollViewer></Expander>
   <WrapPanel><Button x:Name="P25FilterButton" Content="P25 message types: all" Click="OpenP25Types" ToolTip="Choose which P25 message types to display. Hidden messages remain in recent history."/><CheckBox x:Name="GroupRepeated" Content="Group P25 repeats" IsChecked="True" Foreground="#E4EDF8" Margin="0,4,0,0" Checked="GroupChanged" Unchecked="GroupChanged" ToolTip="Keep site/network status in fixed rows. Group headers by decoded identity and undecoded TSBKs by opcode/manufacturer. Details show latest payload and change count; changed grants remain separate. Export follows the selected view."/></WrapPanel>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="FilterText" Grid.Column="1" TextChanged="FilterChanged" Padding="4" ToolTip="Protocol, callsign, station, input or decoded text"/><CheckBox x:Name="ShowInvalid" Grid.Column="2" Content="Show unvalidated" Foreground="#E4EDF8" VerticalAlignment="Center" Margin="12,0,0,0" Checked="FilterChanged" Unchecked="FilterChanged"/></Grid>
  <DataGrid x:Name="PacketGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" SelectionMode="Single" SelectionChanged="SelectionChanged" Background="#101722" Foreground="#142133" AlternatingRowBackground="#E4EDF8" RowBackground="#F6F8FC" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
   <DataGrid.Columns><DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="110"/><DataGridTextColumn Header="Last seen UTC" Binding="{Binding Time}" Width="110"/><DataGridTextColumn Header="Count" Binding="{Binding Repeats}" Width="60"/><DataGridTextColumn Header="From" Binding="{Binding From}" Width="90"/><DataGridTextColumn Header="To" Binding="{Binding To}" Width="80"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Summary" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Validation" Binding="{Binding Status}" Width="100"/></DataGrid.Columns>
  </DataGrid>
  <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="#526881" Cursor="SizeNS" Focusable="True" ToolTip="Drag up or down to resize the data list and details. Arrow keys also adjust the divider." AutomationProperties.Name="Resize data list and details"/>
  <GroupBox Grid.Row="4" Header="Selected data · source and validation" Margin="0,4,0,0"><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#101722" Foreground="#B9CBDF" BorderThickness="0" FontFamily="Consolas" FontSize="12" Text="Select an observation to inspect its source, decoded fields and available raw bytes."/></GroupBox>
 </Grid>
</UserControl>



