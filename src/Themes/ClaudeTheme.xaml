<!--
  M.R.S. dark control theme  (UI refresh "ui1", added by Claude on 2026-11-13)
  Merged from App.xaml. Replaces the old implicit Button / TabItem / ComboBox styles that used light native surfaces.
  Colours are named Mrs.* so later work can reuse them instead of hard-coding Brushes.* values.
  See CLAUDE-UI-NOTES.md at the project root for the full change list.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MRS">

  <!-- Palette -->
  <SolidColorBrush x:Key="Mrs.Window" Color="#101722"/>
  <SolidColorBrush x:Key="Mrs.Surface" Color="#162131"/>
  <SolidColorBrush x:Key="Mrs.SurfaceRaised" Color="#1E2B3D"/>
  <SolidColorBrush x:Key="Mrs.SurfaceHover" Color="#27384F"/>
  <SolidColorBrush x:Key="Mrs.SurfacePressed" Color="#131C29"/>
  <SolidColorBrush x:Key="Mrs.Field" Color="#0C131D"/>
  <SolidColorBrush x:Key="Mrs.Border" Color="#3A4E68"/>
  <SolidColorBrush x:Key="Mrs.BorderSoft" Color="#26364A"/>
  <SolidColorBrush x:Key="Mrs.Text" Color="#E4EDF8"/>
  <SolidColorBrush x:Key="Mrs.TextDim" Color="#9EB1C9"/>
  <SolidColorBrush x:Key="Mrs.Accent" Color="#66DEBA"/>
  <SolidColorBrush x:Key="Mrs.AccentSurface" Color="#1D5646"/>
  <SolidColorBrush x:Key="Mrs.Danger" Color="#E5737A"/>
  <SolidColorBrush x:Key="Mrs.DangerSurface" Color="#5A232A"/>
  <SolidColorBrush x:Key="Mrs.Tx" Color="#D7323A"/>

  <!-- Maps legacy Foreground=Black / dark-red values (written for light buttons) to readable colours on dark surfaces. -->
  <local:ClaudeForegroundConverter x:Key="Mrs.ReadableForeground"/>
  <!-- Returns the text only when it is long enough to be cut off; otherwise no tooltip. -->
  <local:ClaudeLongTextConverter x:Key="Mrs.LongTextOnly"/>

  <!-- Buttons -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Mrs.SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Mrs.Border}"/>
    <Setter Property="Foreground" Value="{StaticResource Mrs.Text}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"
                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Mrs.ReadableForeground}}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Mrs.SurfaceHover}"/><Setter TargetName="Bd" Property="BorderBrush" Value="#5B7594"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Mrs.Accent}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Mrs.SurfacePressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Mrs.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Mrs.AccentSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Mrs.Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Mrs.DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Mrs.DangerSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Mrs.Danger}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Tabs: dark headers with an accent bar on the selected tab -->
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource Mrs.TextDim}"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Background="{StaticResource Mrs.Surface}" BorderBrush="{StaticResource Mrs.BorderSoft}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="0,0,2,0" SnapsToDevicePixels="True">
            <DockPanel>
              <Border x:Name="AccentBar" DockPanel.Dock="Bottom" Height="2" Background="Transparent"/>
              <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Mrs.SurfaceRaised}"/><Setter Property="Foreground" Value="{StaticResource Mrs.Text}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#22344B"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Mrs.Border}"/>
              <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource Mrs.Accent}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
              <Setter Property="Panel.ZIndex" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sidebar tab strip: fixed 3 x 2 grid so rows never swap places when a tab is clicked -->
  <Style x:Key="Mrs.SidebarTabs" TargetType="TabControl">
    <Style.Resources>
      <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="4,6"/><Setter Property="FontSize" Value="13"/></Style>
    </Style.Resources>
    <Setter Property="Background" Value="{StaticResource Mrs.Window}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel KeyboardNavigation.TabNavigation="Local">
            <UniformGrid DockPanel.Dock="Top" Columns="3" IsItemsHost="True" Margin="0,0,0,2" KeyboardNavigation.TabIndex="1"/>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Mrs.Border}" Margin="0,0,0,6"/>
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text boxes (controls that set their own colours keep them) -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Mrs.Field}"/>
    <Setter Property="Foreground" Value="{StaticResource Mrs.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Mrs.Border}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Mrs.Text}"/>
    <Setter Property="SelectionBrush" Value="#4A90C8"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <!-- ComboBox: dark surface, supports editable combos -->
  <ControlTemplate x:Key="Mrs.ComboToggle" TargetType="ToggleButton">
    <Border x:Name="Bd" Background="{StaticResource Mrs.Field}" BorderBrush="{StaticResource Mrs.Border}" BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
      <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Mrs.TextDim}" StrokeThickness="1.6"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#5B7594"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Mrs.Accent}"/><Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Mrs.Accent}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Foreground" Value="{StaticResource Mrs.Text}"/>
    <Setter Property="Background" Value="{StaticResource Mrs.Field}"/>
    <Setter Property="Padding" Value="8,3,26,3"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <ToggleButton x:Name="Toggle" Template="{StaticResource Mrs.ComboToggle}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Mrs.ReadableForeground}}"/>
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="3,2,24,2" Background="Transparent" BorderThickness="0" Padding="2,0"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Mrs.ReadableForeground}}"
                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" VerticalContentAlignment="Center" Focusable="True"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
              <Border x:Name="DropDownBorder" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="#152132" BorderBrush="{StaticResource Mrs.Border}" BorderThickness="1" SnapsToDevicePixels="True">
                <ScrollViewer SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Mrs.Text}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Mrs.AccentSurface}"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Mrs.SurfaceHover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tooltips -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="#1B2738"/>
    <Setter Property="Foreground" Value="{StaticResource Mrs.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Mrs.Border}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MaxWidth" Value="520"/>
  </Style>

  <!-- Tables: dark column headers; long cell text shows in a tooltip -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#1A2636"/>
    <Setter Property="Foreground" Value="#CFE0F2"/>
    <Setter Property="BorderBrush" Value="{StaticResource Mrs.BorderSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
    <Setter Property="ToolTip" Value="{Binding Content.Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Mrs.LongTextOnly}}"/>
    <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
  </Style>
</ResourceDictionary>
